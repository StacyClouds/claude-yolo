#!/bin/sh
# Runs the claude-yolo sandbox against the stacyclouds folder tree.
#
# Usage: claude-yolo --help   (or run with no arguments for a quick reminder
#                              of the most common invocations)
#
# Safe to YOLO because the container has no git binary and can't reach
# anything outside the mounted project folder.
#
# Callable from anywhere: symlinked as ~/.local/bin/claude-yolo, which is on
# PATH. Resolves the symlink itself so the Dockerfile/context can be found
# regardless of where it's invoked from.
set -eu

print_help() {
    cat <<'EOF'
Usage: claude-yolo [--help] [<workspace-path> | --workspace <path>] [--ports <base>] [--secrets] [subcommand] [-- <args for claude>]

  --help, -h           Show this help and exit. Short-circuits everything
                       else: no Docker interaction, no workspace validation.

  <workspace-path>     Mount this host folder as /workspace instead of the
  --workspace <path>   script's own parent directory. Must exist. No rebuild
                       required - this is a docker run -v argument, resolved
                       fresh each call. Either spelling works the same way
                       and must come before the subcommand. A directory
                       named exactly "run", "yolo", "rebuild", or "nuke"
                       needs an explicit form (e.g. ./run) since those
                       four words are always read as subcommands first.

  --ports <base>       Publish 20 ports, <base> through <base>+19, on the
                       host's loopback (127.0.0.1 only), mapped to the same
                       numbers inside the container, so a test app, Aspire
                       dashboard etc. is reachable at http://localhost:<port>.
                       Claude is told to keep its apps within that range.
                       Must come before the subcommand. Without it nothing
                       is published. Valid base: 1024-65516.

  --secrets            Share this workspace's .NET user secrets with the
                       container, read-only. Finds every UserSecretsId in
                       the workspace's *.csproj and Directory.Build.props
                       files and mounts only those folders from
                       ~/.microsoft/usersecrets. Anything running in the
                       container, including Claude, can read them; Claude is
                       told not to, which is advice, not a block. Must come
                       before the subcommand (either order with --ports).
                       Without it nothing is shared.

Subcommands:
  (none)               Same as "yolo".
  yolo    [-- args...] Ensure the image exists (building it only if
                       missing), then run claude --dangerously-skip-
                       permissions [args...] (YOLO mode).
  run     [-- args...] Same image-ensure behavior, then run claude
                       [args...] with normal permission prompts.
  rebuild              Force a fresh docker build (refreshes Claude Code and
                       the base image); does not run a container.
  nuke [--preserve-token]
                       Remove the built image and the claude-yolo-home
                       volume (your persisted Claude login), after
                       confirmation. With --preserve-token, the volume is
                       emptied instead of removed, keeping only
                       ~/.claude/.credentials.json (your OAuth token).

Everything after "--" is forwarded verbatim to the claude invocation
(ignored for rebuild/nuke, which never launch claude). Use "--" whenever an
argument to claude itself starts with "-", or whenever you're passing a
prompt string, so it can never be mistaken for a workspace path or
subcommand.

Examples:
  claude-yolo
  claude-yolo run -- "review this file"
  claude-yolo ../other-project run
  claude-yolo --ports 5100
  claude-yolo ../other-project -- --model opus -p "one-shot query"
  claude-yolo rebuild
EOF
}

resolve_path() {
    target="$1"
    while [ -L "$target" ]; do
        dir="$(cd "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        case "$target" in
            /*) ;;
            *) target="$dir/$target" ;;
        esac
    done
    printf '%s\n' "$target"
}

# --help/-h short-circuits everything else: no Docker interaction, no
# workspace validation, exits immediately.
case "${1:-}" in
    --help|-h)
        print_help
        exit 0
        ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$(resolve_path "$0")")" && pwd)"

IMAGE=claude-yolo
VOLUME=claude-yolo-home
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# --workspace must come before the subcommand: args after the subcommand (or
# after claude-yolo itself in the no-args/yolo default) are only reachable
# past a "--" separator (see below), so allowing --workspace there too would
# make it ambiguous which side it was meant for.
if [ "${1:-}" = "--workspace" ]; then
    if [ "$#" -lt 2 ]; then
        echo "claude-yolo: --workspace requires a path argument" >&2
        exit 1
    fi
    if [ ! -d "$2" ]; then
        echo "claude-yolo: --workspace path '$2' does not exist or is not a directory" >&2
        exit 1
    fi
    PROJECT_DIR="$(cd "$2" && pwd)"
    shift 2
elif [ "$#" -ge 1 ]; then
    # A bare leading argument that isn't a recognized subcommand keyword is
    # treated as a workspace-path override (the same thing --workspace does,
    # just without the flag) - this is what lets `claude-yolo .` mount the
    # current directory instead of silently becoming a `claude` argument.
    # Subcommand keywords always win: a directory literally named "run" (or
    # "yolo"/"rebuild"/"nuke") needs an explicit form like `./run` to be
    # used as a workspace path.
    case "$1" in
        rebuild|nuke|run|yolo|--|--ports|--secrets)
            ;;
        -*)
            echo "claude-yolo: unknown option '$1' (see claude-yolo --help)" >&2
            exit 1
            ;;
        *)
            if [ ! -d "$1" ]; then
                echo "claude-yolo: '$1' does not exist as a directory to mount as the workspace, and is not a recognized subcommand - if this was meant for claude, use '--' before it (e.g. claude-yolo -- '$1')" >&2
                exit 1
            fi
            PROJECT_DIR="$(cd "$1" && pwd)"
            shift
            ;;
    esac
fi

# --ports <base> publishes <base>..<base>+19 and --secrets shares the
# workspace's .NET user secrets (see print_help). Both go after any workspace
# path/--workspace and before the subcommand, for the same ambiguity reason as
# --workspace above, and may appear in either order.
PORT_BASE=""
PORT_COUNT=20
SHARE_SECRETS=""
while :; do
    case "${1:-}" in
        --ports)
            if [ "$#" -lt 2 ]; then
                echo "claude-yolo: --ports requires a base port argument" >&2
                exit 1
            fi
            case "$2" in
                ''|*[!0-9]*)
                    echo "claude-yolo: --ports base '$2' is not a number" >&2
                    exit 1
                    ;;
            esac
            if [ "$2" -lt 1024 ] || [ "$2" -gt $((65535 - PORT_COUNT + 1)) ]; then
                echo "claude-yolo: --ports base must be between 1024 and $((65535 - PORT_COUNT + 1))" >&2
                exit 1
            fi
            PORT_BASE="$2"
            shift 2
            ;;
        --secrets)
            SHARE_SECRETS=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

# One "host:container:ro" mount per secrets id the workspace refers to whose
# folder exists in the host's user-secrets store. The store is the filter: only
# folders that exist there are ever mounted, never the whole store. Candidate
# ids come from one pass over the workspace's project and source files:
#   - <UserSecretsId> elements;
#   - the literal in AddUserSecrets("id") / AddUserSecrets<T>("id") and in an
#     assignment to a name ending in UserSecretsId (an app can load a second
#     set by an id that is only a string in code);
#   - any GUID-shaped string, which catches such an id held in a constant and
#     passed by name (AddUserSecrets(SiteUserSecretsId)).
# Ids are checked against a plain-identifier pattern (and "." / ".." are
# rejected) so a project file cannot point a mount at some other host path.
# Ids split over several lines, built at run time or kept in other file types
# are not found.
SECRET_MOUNTS=""
collect_secret_mounts() {
    store="$HOME/.microsoft/usersecrets"
    guid='[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}'
    pat="$guid"
    pat="$pat|<UserSecretsId>[^<]*</UserSecretsId>"
    pat="$pat|AddUserSecrets(<[^>]*>)?\\(\"[^\"]*\"\\)"
    pat="$pat|[A-Za-z_]*UserSecretsId[[:space:]]*=[[:space:]]*\"[^\"]*\""
    ids="$(grep -rhoE \
            --include='*.cs' --include='*.fs' --include='*.vb' \
            --include='*.razor' --include='*.cshtml' \
            --include='*.csproj' --include='*.fsproj' --include='*.vbproj' \
            --include='*.props' --include='*.targets' \
            --exclude-dir=.git --exclude-dir=node_modules \
            --exclude-dir=bin --exclude-dir=obj \
            -e "$pat" "$PROJECT_DIR" 2>/dev/null \
        | sed -E -e 's|^<UserSecretsId>(.*)</UserSecretsId>$|\1|' \
                 -e 's|^AddUserSecrets(<[^>]*>)?\("(.*)"\)$|\2|' \
                 -e 's|^[A-Za-z_]*UserSecretsId[[:space:]]*=[[:space:]]*"(.*)"$|\1|' \
                 -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        | sort -u)"
    while IFS= read -r id; do
        case "$id" in
            ''|.|..|*[!A-Za-z0-9._-]*) continue ;;
        esac
        [ -d "$store/$id" ] || continue
        SECRET_MOUNTS="$SECRET_MOUNTS$store/$id:/home/node/.microsoft/usersecrets/$id:ro
"
    done <<IDS
$ids
IDS
}
if [ -n "$SHARE_SECRETS" ]; then
    collect_secret_mounts
fi

# Mounted read-only at run time (not baked into the image) so edits to your
# global ~/.claude folder (settings, agents, skills, plugins, commands, etc.)
# take effect on the next run without a rebuild. Skipped entirely if you
# don't have one.
#
# Mounted at .claude-host, NOT directly at .claude: the container's
# entrypoint.sh copies just the config items out of it into the writable
# /home/node/.claude (part of the persisted $VOLUME) on every start, so
# Claude's login/session state there survives across runs instead of being
# shadowed by this read-only mount. See entrypoint.sh for details.
CLAUDE_CONFIG_MOUNT=""
if [ -d "$HOME/.claude" ]; then
    CLAUDE_CONFIG_MOUNT="--volume=$HOME/.claude:/home/node/.claude-host:ro"
fi

# Extra arguments are passed through to docker build (rebuild uses this to
# defeat the layer cache for the Claude Code install).
build_image() {
    docker build "$@" -t "$IMAGE" "$SCRIPT_DIR"
}

image_exists() {
    docker image inspect "$IMAGE" >/dev/null 2>&1
}

ensure_image() {
    if ! image_exists; then
        build_image
    fi
}

run_container() {
    # The docker options are built in the positional parameters so that a
    # variable number of -v arguments (paths may contain spaces) can sit before
    # the image: they are appended after claude's own arguments, then claude's
    # arguments are rotated to the end.
    n=$#
    # claude-yolo-home persists Claude's login/auth across container runs,
    # separate from the project bind mount so it never lands inside a repo.
    set -- "$@" -it --rm -v "$PROJECT_DIR":/workspace -v "$VOLUME":/home/node
    if [ -n "$CLAUDE_CONFIG_MOUNT" ]; then
        set -- "$@" "$CLAUDE_CONFIG_MOUNT"
    fi
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        set -- "$@" -e ANTHROPIC_API_KEY
    fi
    if [ -n "$PORT_BASE" ]; then
        set -- "$@" -p "127.0.0.1:$PORT_BASE-$((PORT_BASE + PORT_COUNT - 1)):$PORT_BASE-$((PORT_BASE + PORT_COUNT - 1))" \
            -e "CLAUDE_YOLO_BASE_PORT=$PORT_BASE" -e "CLAUDE_YOLO_PORT_COUNT=$PORT_COUNT"
    fi
    if [ -n "$SHARE_SECRETS" ]; then
        set -- "$@" -e "CLAUDE_YOLO_SECRETS=1"
        while IFS= read -r m; do
            if [ -n "$m" ]; then
                set -- "$@" -v "$m"
            fi
        done <<MOUNTS
$SECRET_MOUNTS
MOUNTS
    fi
    set -- "$@" "$IMAGE"
    i=0
    while [ "$i" -lt "$n" ]; do
        a="$1"
        shift
        set -- "$@" "$a"
        i=$((i + 1))
    done
    docker run "$@"
}

MODE=yolo
case "${1:-}" in
    rebuild|nuke|run|yolo)
        MODE="$1"
        shift
        ;;
esac

# Arguments meant for `claude` itself (for run/yolo modes) must come after a
# literal "--", so they can never be mistaken for a workspace path or
# subcommand. rebuild/nuke don't forward anything to claude, so this doesn't
# apply to them (nuke has its own --preserve-token flag, parsed in its own
# branch below).
require_dashdash() {
    case "$1" in
        --) ;;
        *)
            echo "claude-yolo: unexpected argument '$1' - use '--' before arguments meant for claude (e.g. claude-yolo $MODE -- '$1')" >&2
            exit 1
            ;;
    esac
}

case "$MODE" in
    rebuild)
        build_image --pull --build-arg "CLAUDE_CODE_CACHE_BUST=$(date +%s)"
        ;;
    nuke)
        PRESERVE_TOKEN=0
        if [ "${1:-}" = "--preserve-token" ]; then
            PRESERVE_TOKEN=1
            shift
        fi

        if [ "$PRESERVE_TOKEN" -eq 1 ]; then
            printf 'This removes the %s image and clears the %s volume, but keeps your Claude login token (~/.claude/.credentials.json). Continue? [y/N] ' "$IMAGE" "$VOLUME"
        else
            printf 'This removes the %s image and the %s volume (your Claude login). Continue? [y/N] ' "$IMAGE" "$VOLUME"
        fi
        read -r reply
        case "$reply" in
            [yY]|[yY][eE][sS])
                if [ "$PRESERVE_TOKEN" -eq 1 ]; then
                    # Gut the volume in place instead of removing it, so the
                    # login token survives. Copy .credentials.json out to the
                    # helper container's own /tmp (NOT under /home/node, so
                    # it isn't wiped by the same command), delete everything
                    # else in the volume, then copy the token back in.
                    #
                    # Needs a container with sh/find/cp/chmod to do the
                    # gutting; reuse $IMAGE while it still exists (about to
                    # be rmi'd below) rather than pulling something extra.
                    # Falls back to busybox if $IMAGE was never built (e.g.
                    # nuke called before any run) but the volume somehow
                    # exists.
                    if docker volume inspect "$VOLUME" >/dev/null 2>&1; then
                        HELPER_IMAGE="$IMAGE"
                        image_exists || HELPER_IMAGE=busybox
                        docker run --rm -v "$VOLUME":/home/node "$HELPER_IMAGE" sh -c '
                            set -e
                            SRC=/home/node/.claude/.credentials.json
                            TMP=/tmp/preserved-credentials.json
                            [ -f "$SRC" ] && cp "$SRC" "$TMP"
                            find /home/node -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                            if [ -f "$TMP" ]; then
                                mkdir -p /home/node/.claude
                                cp "$TMP" "$SRC"
                                chmod 600 "$SRC"
                            fi
                        '
                    fi
                    docker rmi "$IMAGE"
                else
                    docker rmi "$IMAGE"
                    docker volume rm "$VOLUME"
                fi
                ;;
            *)
                echo "Aborted." >&2
                ;;
        esac
        ;;
    run)
        if [ "$#" -gt 0 ]; then
            require_dashdash "$1"
            shift
        fi
        ensure_image
        run_container claude "$@"
        ;;
    yolo)
        if [ "$#" -gt 0 ]; then
            require_dashdash "$1"
            shift
        fi
        ensure_image
        run_container claude --dangerously-skip-permissions "$@"
        ;;
esac
